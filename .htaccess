Options -Indexes

RewriteEngine On

# Uploads are served through index.php (?file=...) so project authorization applies.
RewriteRule ^uploads/ - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]

<FilesMatch "\.(sqlite|sqlite3|db|sql)(-wal|-shm|-journal)?$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(env|bak)$">
    Require all denied
</FilesMatch>

RewriteRule \.git - [F,L]

<Files "tests.php">
    Require all denied
</Files>
